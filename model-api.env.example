# Variables read by compose.production.yml. The real values live OUTSIDE git, in the shared
# /opt/invoiceops/invoiceops.env (chmod 600); the runbook in invoiceops-app/dev tickets MLOPS-07
# generates them. Secrets are hex (URL-safe).
# Bearer secret the backend sends (same value as MODEL_API_SERVICE_TOKEN of the app). >= 32 chars.
MODEL_API_SERVICE_TOKEN=
# Secret of the hidden validation set. Never shared with the app or students: openssl rand -hex 32
OFFICIAL_VALIDATION_SEED=
# Read-only service token of the gateway (same value as GATEWAY_SERVICE_READ_TOKEN of gateway/app).
GATEWAY_SERVICE_READ_TOKEN=
# Optional overrides (defaults are the production values).
# MODEL_API_VERSION=latest
# INVOICEOPS_ML_CONTEXT=../ml   (server layout; locally ../invoiceops-ml)
# MODEL_API_MLFLOW_URI=http://invoiceops-mlflow-gateway:8080
# INVOICEOPS_API_NETWORK=invoiceops_api
# Optional bounds (see README, "Configuration"); leave unset/empty for the defaults shown.
# MAX_BODY_BYTES=4194304
# MAX_TOTAL_PRIORS=20000
# MAX_LOADED_DEPLOYMENTS=30
# MAX_MODEL_BYTES=67108864
# MAX_CONCURRENT_DOWNLOADS=2
# MODEL_API_MLFLOW_MAX_RETRIES=2
# MODEL_API_MLFLOW_TIMEOUT_SECONDS=15
# MODEL_API_MLFLOW_BUDGET_SECONDS=45
# MODEL_CHECK_TIMEOUT_SECONDS=60
# MODEL_CHECK_CONCURRENCY=2
# MODEL_INFERENCE_TIMEOUT_SECONDS=10
# Address-space limits (MB) of the check child and the inference worker (compose default 1024; keep
# them below the container memory limit).
# MODEL_CHECK_MEMORY_MB=1024
# MODEL_WORKER_MEMORY_MB=1024
# Deploy gate thresholds and the size of the hidden validation set.
# GATE_MIN_AUC=0.70
# GATE_MIN_LIFT=0.02
# OFFICIAL_VALIDATION_ROWS=4000
# Optional dedicated HMAC key (>= 32 chars) of the audit digest in the logs. Default: derived from
# MODEL_API_SERVICE_TOKEN (HMAC-SHA-256 with a fixed label), so it differs per deployment.
# MODEL_API_AUDIT_HMAC_KEY=
# Seconds a deploy check waits for a free check slot before answering 503 BUSY (default 10).
# MODEL_CHECK_WAIT_SECONDS=10
